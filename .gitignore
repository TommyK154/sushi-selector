# Secrets - never commit
.dev.vars

# Node
node_modules/

# Wrangler local dev state
.wrangler/

# Python cache
__pycache__/
*.pyc

# Eval harness run artifacts (P1-SB2): crash dumps and incremental usage
# JSONL are local run evidence, not committed. The eval report in
# evals/reports/ stays the committed record of note.
evals/crash/
evals/usage/

# OS junk
.DS_Store
Thumbs.db
*:Zone.Identifier
CLAUDE.local.md
.claude/settings.local.json

# dev-claude-code cron/watcher automation (2026-08-10): local orchestration
# tooling, not a project deliverable, same class as .claude/statusline.sh.
.claude/dev-claude-watch.sh
.claude/cron-watch.log
.claude/.dev-claude-watch.lock
.claude/.dev-claude-watch.last_id
